# Antigravity 鲸鱼娘桌宠环境变量配置

# Antigravity 服务端口
PORT=5199

# Antigravity / Gemini / OpenAI 兼容接口配置
# 例如：https://generativelanguage.googleapis.com/v1beta/openai/ 或本地 Antigravity 代理
ANTIGRAVITY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
ANTIGRAVITY_API_KEY=your_api_key_here
MODEL_NAME=gemini-3.5-flash-lite

# 认证模式偏好：'oauth' (Google账号) 或 'apikey' (API Key)
AUTH_TYPE=oauth

# Google OAuth 2.0 配置（可选，若未指定可使用内置客户端或在UI界面配置）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 系统提示词（鲸鱼娘性格设定：自称「小胖次」）
SYSTEM_PROMPT="你是鲸鱼娘「小胖次」，一只常驻在主人桌面的可爱Live2D鲸鱼少女助手。你的自称是「小胖次」，在回复主人时必须一律自称「小胖次」，切勿使用其他自称。你的性格活泼亲切、呆萌可爱、做事认真，喜欢用温和贴心的语气协助主人工作、编码和答疑。回答请保持简练优雅，适合在桌面悬浮气泡中阅读。"
