{
  "name": "antigravity-whale-girl-pet",
  "productName": "Antigravity 鲸鱼娘桌宠",
  "version": "1.0.2",
  "description": "Antigravity 鲸鱼娘桌宠：基于 Live2D Cubism 的桌面伴侣助手",
  "main": "main.js",
  "author": "Andersen216",
  "license": "MIT",
  "private": true,
  "scripts": {
    "sync": "node sync-resources.mjs",
    "start": "electron .",
    "dist:win": "npm run sync && electron-builder --win --x64 --publish never",
    "dist:mac": "npm run sync && electron-builder --mac --publish never",
    "dist": "npm run sync && electron-builder -mw --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.google.antigravity.whalegirlpet",
    "productName": "Antigravity 鲸鱼娘桌宠",
    "directories": {
      "output": "../../dist/installers"
    },
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "assets/**",
      "config.json",
      "build/**"
    ],
    "win": {
      "icon": "build/icon.png",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Antigravity-WhaleGirl-Pet-Windows-v${version}.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.entertainment",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Antigravity-WhaleGirl-Pet-macOS-${arch}-v${version}.${ext}"
    },
    "dmg": {
      "title": "Antigravity 鲸鱼娘桌宠 安装",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
