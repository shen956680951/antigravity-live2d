{
  "name": "antigravity-whale-girl-live2d",
  "version": "1.0.0",
  "description": "Antigravity 鲸鱼娘：基于 Live2D Cubism 的 Antigravity 可视化桌面伴侣助手。模型常驻桌面，联动 Antigravity 状态换表情与动作，支持流式对话与打字机唇形同步。",
  "keywords": [
    "antigravity",
    "gemini",
    "live2d",
    "cubism",
    "desktop-pet",
    "桌宠",
    "鲸鱼娘",
    "whale-girl"
  ],
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "assets",
    "desktop",
    "config.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node lib/server.js",
    "dev": "node --watch lib/server.js",
    "build:desktop": "bash tools/build-desktop-mac.sh",
    "build:win": "npm --prefix desktop/windows run dist:win",
    "build:mac": "npm --prefix desktop/windows run dist:mac",
    "build:installers": "npm --prefix desktop/windows run dist",
    "build:model": "node tools/build-model.mjs",
    "preview": "node tools/preview-server.mjs",
    "test": "node test/integration.test.mjs"
  },
  "license": "MIT",
